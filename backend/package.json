{
  "name": "estat-healthcheck-backend",
  "version": "1.0.0",
  "description": "Hono backend for e-Stat health check",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "sh -c 'echo y | wrangler d1 migrations apply estat_health_history --local && wrangler dev --ip 0.0.0.0'",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply estat_health_history --local",
    "db:migrate:remote": "wrangler d1 migrations apply estat_health_history --remote"
  },
  "dependencies": {
    "hono": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240512.0",
    "typescript": "^5.4.0",
    "wrangler": "^4"
  }
}
